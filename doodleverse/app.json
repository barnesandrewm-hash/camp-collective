{
  "expo": {
    "name": "Doodleverse",
    "slug": "doodleverse",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF9A9E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Doodleverse saves your drawings to your photo library.",
        "NSPhotoLibraryUsageDescription": "Doodleverse accesses your photo library to save drawings."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF9A9E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Doodleverse saves your drawings to your photo library.",
          "savePhotosPermission": "Doodleverse saves your drawings to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
